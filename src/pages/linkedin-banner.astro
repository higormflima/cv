---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

// LinkedIn banner (1584×396). The profile photo covers the lower-left corner, so text sits on the right.
const W = 1584;
const H = 396;
let seed = 11;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

// Clustered knowledge graph: lime hub nodes with grey satellites, hubs linked to each other.
const hubs = [
  { x: 120, y: 110, r: 8 },
  { x: 300, y: 250, r: 10 },
  { x: 470, y: 120, r: 8 },
  { x: 560, y: 300, r: 7 },
  { x: 140, y: 320, r: 6 },
];
const sats = hubs.flatMap((hub, h) =>
  Array.from({ length: 10 + Math.round(rand() * 6) }, () => {
    const angle = rand() * Math.PI * 2;
    const dist = 26 + rand() * 62;
    return { x: hub.x + Math.cos(angle) * dist, y: hub.y + Math.sin(angle) * dist, r: 1.4 + rand() * 1.6, h };
  }),
);
const hubLinks = hubs.flatMap((a, i) => hubs.slice(i + 1).filter((b) => Math.hypot(a.x - b.x, a.y - b.y) < 260).map((b) => [a.x, a.y, b.x, b.y]));
const satLinks: [number, number, number, number][] = [];
sats.forEach((a, i) =>
  sats.slice(i + 1).forEach((b) => {
    if (a.h === b.h && Math.hypot(a.x - b.x, a.y - b.y) < 34) satLinks.push([a.x, a.y, b.x, b.y]);
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>LinkedIn banner</title>
  </head>
  <body>
    <div class="banner">
      <div class="grid"></div>
      <div class="glow"></div>
      <svg class="flow" width={W} height={H} viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        {hubLinks.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(198,244,50,0.28)" stroke-width="1.2" stroke-dasharray="3 5" />)}
        {sats.map((s) => <line x1={hubs[s.h].x} y1={hubs[s.h].y} x2={s.x} y2={s.y} stroke="rgba(163,175,187,0.2)" />)}
        {satLinks.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="rgba(163,175,187,0.12)" />)}
        {sats.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="rgba(163,175,187,0.6)" />)}
        {hubs.map((h) => (
          <>
            <circle cx={h.x} cy={h.y} r={h.r + 7} fill="none" stroke="rgba(198,244,50,0.35)" stroke-dasharray="2 4" />
            <circle cx={h.x} cy={h.y} r={h.r} fill="#c6f432" />
          </>
        ))}
      </svg>
      <div class="copy">
        <p class="comment">// output</p>
        <h1>
          A <span class="g-data">data professional</span> who thinks like an <span class="g-eng">engineer</span>,
          tests like <span class="g-qa">QA</span>, and delivers like a <span class="g-mil">sergeant</span>.
        </h1>
        <p class="meta"><b>Higor Lima</b> · Data Specialist · AI-ready data products <span class="sep">|</span> <span class="url">higormflima.github.io/cv</span></p>
      </div>
      <span class="corner mono">&lt;HL/&gt;<i></i></span>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; }
  .banner { position: relative; width: 1584px; height: 396px; overflow: hidden; background: #07090d; color: #e9eef3; font-family: 'Inter Variable', sans-serif; }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 4.5%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 4.5%) 1px, transparent 1px); background-size: 44px 44px; mask-image: radial-gradient(ellipse 80% 120% at 65% 50%, #000 35%, transparent 85%); }
  .glow { position: absolute; top: -260px; right: 120px; width: 760px; height: 760px; border-radius: 50%; background: radial-gradient(circle, rgb(198 244 50 / 16%), transparent 60%); }
  .flow { position: absolute; inset: 0; mask-image: linear-gradient(90deg, #000 33%, transparent 43%); }
  .copy { position: absolute; top: 50%; right: 80px; width: 820px; transform: translateY(-50%); }
  .comment { margin: 0 0 14px; color: #6d7a87; font: 500 18px 'JetBrains Mono Variable', monospace; }
  h1 { margin: 0 0 22px; font-size: 44px; font-weight: 750; letter-spacing: -.035em; line-height: 1.14; }
  .g-data { background: linear-gradient(100deg, #c6f432, #3ee6ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .g-eng { color: #a78bfa; }
  .g-qa { color: #3ee6ff; }
  .g-mil { color: #ffb547; }
  .meta { margin: 0; color: #a3afbb; font: 500 17px 'JetBrains Mono Variable', monospace; }
  .meta b { color: #e9eef3; font-weight: 700; }
  .sep { color: #3a4450; }
  .url { color: #c6f432; }
  .corner { position: absolute; top: 22px; right: 30px; display: inline-flex; align-items: baseline; gap: 3px; color: #6d7a87; font: 700 15px 'JetBrains Mono Variable', monospace; }
  .corner i { width: 9px; height: 2px; background: #c6f432; }
</style>
