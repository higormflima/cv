---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { profile } from '../data/profile';
import { metrics } from '../data/metrics';
import { base } from '../lib/paths';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="og">
      <div class="grid"></div>
      <div class="glow"></div>
      <div class="copy">
        <p class="eyebrow"><i></i>status: building AI-ready data foundations</p>
        <h1>From raw data<br />to <span>real business value.</span></h1>
        <p class="name">{profile.name} <b>· {profile.title} · {profile.shortLocation}</b></p>
        <div class="kpis">
          {metrics.slice(0, 4).map((m) => <div><strong>{m.value}{m.suffix}</strong><small>{m.label}</small></div>)}
        </div>
      </div>
      <div class="photo">
        <img src={`${base}${profile.portrait}`} alt="" />
        <span class="tag">person · higor_lima <b>0.99</b></span>
      </div>
      <p class="url">higormflima.github.io/cv</p>
    </div>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; }
  .og { position: relative; display: flex; width: 1200px; height: 630px; overflow: hidden; align-items: center; gap: 48px; padding: 0 72px; background: #07090d; color: #e9eef3; font-family: 'Inter Variable', sans-serif; }
  .grid { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 75%); }
  .glow { position: absolute; top: -200px; right: -100px; width: 700px; height: 700px; border-radius: 50%; background: radial-gradient(circle, rgb(198 244 50 / 22%), transparent 60%); }
  .copy { position: relative; flex: 1; }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 22px; color: #c6f432; font: 500 18px 'JetBrains Mono Variable', monospace; }
  .eyebrow i { width: 10px; height: 10px; border-radius: 50%; background: #c6f432; box-shadow: 0 0 14px #c6f432; }
  h1 { margin: 0 0 24px; font-size: 64px; font-weight: 750; letter-spacing: -.05em; line-height: 1.02; }
  h1 span { background: linear-gradient(100deg, #c6f432, #3ee6ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .name { margin: 0 0 30px; font-size: 24px; font-weight: 650; }
  .name b { color: #a3afbb; font-weight: 400; }
  .kpis { display: flex; gap: 14px; }
  .kpis div { display: grid; width: 150px; padding: 12px 14px; border: 1px solid rgb(255 255 255 / 12%); border-radius: 12px; background: rgb(255 255 255 / 3%); }
  .kpis strong { font: 700 28px 'JetBrains Mono Variable', monospace; letter-spacing: -.04em; }
  .kpis small { color: #a3afbb; font-size: 13px; line-height: 1.25; }
  .photo { position: relative; width: 300px; height: 400px; flex: 0 0 auto; overflow: hidden; border: 1px solid rgb(255 255 255 / 14%); border-radius: 18px; }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .photo::after { position: absolute; top: 14%; right: 16%; bottom: 32%; left: 18%; border: 2px solid #c6f432; content: ''; }
  .tag { position: absolute; top: calc(14% - 26px); left: 18%; z-index: 1; padding: 3px 8px; background: #c6f432; color: #0a0d12; font: 600 13px 'JetBrains Mono Variable', monospace; }
  .url { position: absolute; bottom: 24px; left: 72px; margin: 0; color: #6d7a87; font: 500 16px 'JetBrains Mono Variable', monospace; }
</style>
