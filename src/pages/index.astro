---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import KpiStrip from '../components/KpiStrip.astro';
import CareerGantt from '../components/CareerGantt.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
import { cv } from '../data/cv';
import { base } from '../lib/paths';
import { highlightJson } from '../lib/highlight';

const current = experience[0];
const excerpt = {
  basics: { name: cv.basics.name, label: cv.basics.label, headline: cv.basics.headline, location: cv.basics.location },
  work: [{ name: current.organization, position: current.role, startDate: current.start, keywords: current.stack?.slice(0, 4) }],
  languages: cv.languages.map((l) => l.language),
};
const excerptJson = JSON.stringify(excerpt, null, 2).replace(/\n\}$/, `,\n  // … ${cv.work.length - 1} more roles · GET /api/profile.json\n}`);

const queries = [
  { q: `SELECT focus FROM career WHERE year = ${new Date().getFullYear()};`, a: `→ "AI-ready consumer data assets @ ${current.organization}"` },
  { q: 'SELECT COUNT(*) FROM careers ORDER BY curiosity DESC;', a: '→ 4  -- military · engineering · quality · data' },
  { q: "SELECT stack FROM skills WHERE used_at = 'Reckitt';", a: '→ BigQuery, Databricks, Power BI, Agile' },
  { q: 'SELECT value FROM raw_data JOIN business USING (insight);', a: '→ 1 row · real business value ✓  (6+ yrs)' },
];

const cards = [
  { n: '01', path: '~/story', title: 'Story', note: 'Army → engineering → data. Why the detour matters.', href: '/story/' },
  { n: '02', path: '~/experience', title: 'Experience', note: `${experience.length} roles on an interactive timeline.`, href: '/experience/' },
  { n: '03', path: '~/skills', title: 'Skills graph', note: 'Tools, practices and where they were used.', href: '/skills/' },
  { n: '04', path: '~/projects', title: 'Projects', note: 'Case studies with data-lineage diagrams.', href: '/projects/' },
];
---

<SiteLayout title="Higor Lima | Data Specialist · AI-ready data foundations" description="Higor Lima is a Data Specialist in Warsaw building AI-ready data foundations, with 6+ years in data analysis, business intelligence and data governance across FMCG and procurement.">
  <section class="hero">
    <HeroCanvas />
    <div class="hero-grid page-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span>status: building AI-ready data foundations @ {current.organization}</p>
        <h1 class="hero-title">From raw data<br /> to <span class="gradient-text">real business value.</span></h1>
        <p class="hero-intro"><strong>{profile.name}</strong> is a {profile.title} in {profile.shortLocation} with {profile.yearsExperience} years in data analysis, business intelligence and media analytics across FMCG and procurement, now building governed, AI-ready consumer data assets at {current.organization}.</p>

        <div class="terminal card" aria-label="Example query">
          <div class="terminal-bar" aria-hidden="true"><i></i><i></i><i></i><span>higor@warsaw: ~/career</span></div>
          <div class="terminal-body" data-terminal data-queries={JSON.stringify(queries)}>
            <p><span class="prompt">❯</span> <span data-terminal-query>{queries[0].q}</span><span class="caret" aria-hidden="true"></span></p>
            <p class="terminal-result" data-terminal-result>{queries[0].a}</p>
          </div>
        </div>

        <div class="actions hero-actions">
          <a class="button button-primary" href={`${base}/experience/`}>Explore experience <span aria-hidden="true">→</span></a>
          <button class="button" type="button" data-ask-trigger>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"></path></svg>
            Ask my CV
          </button>
          <a class="button button-ghost" href={`${base}/documents/higor-lima-cv.pdf`} download>CV.pdf <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-contact mono">
          <a href={`mailto:${profile.email}`}>email</a><span>·</span>
          <a href={profile.linkedIn} target="_blank" rel="noreferrer">linkedin ↗</a><span>·</span>
          <a href={`${base}/api/profile.json`}>profile.json</a><span>·</span>
          <span>press <kbd>/</kbd> to search</span>
        </p>
      </div>

      <div class="hero-portrait">
        <div class="detect">
          <img src={`${base}${profile.portrait}`} alt={profile.portraitAlt} width="900" height="1305" fetchpriority="high" />
          <span class="scan" aria-hidden="true"></span>
          <div class="bbox" aria-hidden="true">
            <span class="bbox-label">person · higor_lima <b>0.99</b></span>
            <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          </div>
        </div>
        <ul class="float-tags mono" aria-hidden="true">
          <li style="--d:0s">role: <b>"{profile.title}"</b></li>
          <li style="--d:1.2s">stack: <b>["Databricks", "BigQuery", "Power BI"]</b></li>
          <li style="--d:2.4s">location: <b>"{profile.shortLocation}"</b></li>
        </ul>
      </div>
    </div>
  </section>

  <KpiStrip />

  <section class="section page-shell" aria-labelledby="career-heading">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">// 01 career.timeline</p>
        <h2 id="career-heading">Two decades, one dataset.</h2>
      </div>
      <p>Four careers in sequence: military aviation, engineering, quality, and now data. Each one feeds the next.</p>
    </div>
    <CareerGantt compact />
  </section>

  <section class="section page-shell" aria-labelledby="json-heading">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">// 02 machine-readable</p>
        <h2 id="json-heading">Read it as a human. Or as JSON.</h2>
      </div>
      <p>The whole CV is a public endpoint. Fetch it, parse it, pipe it into your ATS.</p>
    </div>
    <div class="json-panel card" data-reveal data-tabs>
      <div class="tabs" role="tablist" aria-label="CV format">
        <button role="tab" id="tab-human" aria-controls="panel-human" aria-selected="true" type="button">README.md</button>
        <button role="tab" id="tab-json" aria-controls="panel-json" aria-selected="false" tabindex="-1" type="button">profile.json</button>
        <span class="tabs-spacer"></span>
        <button class="copy-button mono" type="button" data-copy-curl>curl …/api/profile.json <span data-copy-state>⧉</span></button>
      </div>
      <div class="tab-panel human-view" role="tabpanel" id="panel-human" aria-labelledby="tab-human">
        <p class="md-h1"><span class="md-mark">#</span> {profile.name}</p>
        <p class="md-quote">{profile.headline} · {profile.tagline}</p>
        <p>{profile.summary}</p>
        <p class="md-h2"><span class="md-mark">##</span> Now</p>
        <p>{profile.focus}</p>
        <ul class="chip-row">{current.stack?.map((item) => <li class="chip">{item}</li>)}</ul>
      </div>
      <div class="tab-panel" role="tabpanel" id="panel-json" aria-labelledby="tab-json" hidden>
        <pre class="code"><code set:html={highlightJson(excerptJson)} /></pre>
      </div>
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="explore-heading">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">// 03 explore</p>
        <h2 id="explore-heading">Go deeper.</h2>
      </div>
    </div>
    <div class="explore-grid">
      {cards.map((card, index) => (
        <a class="explore-card card card-glow" href={`${base}${card.href}`} data-reveal style={`--reveal-delay:${index * 80}ms`}>
          <span class="explore-path mono">{card.path}</span>
          <span class="explore-title">{card.title}</span>
          <span class="explore-note">{card.note}</span>
          <span class="explore-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<script>
  document.querySelectorAll('[data-ask-trigger]').forEach((button) =>
    button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('askcv:open'))),
  );

  const terminal = document.querySelector<HTMLElement>('[data-terminal]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (terminal && !reduce) {
    const queries: { q: string; a: string }[] = JSON.parse(terminal.dataset.queries ?? '[]');
    const queryEl = terminal.querySelector<HTMLElement>('[data-terminal-query]')!;
    const resultEl = terminal.querySelector<HTMLElement>('[data-terminal-result]')!;
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const loop = async () => {
      for (let i = 0; ; i = (i + 1) % queries.length) {
        resultEl.classList.remove('is-shown');
        queryEl.textContent = '';
        for (const char of queries[i].q) {
          queryEl.textContent += char;
          await wait(28 + Math.random() * 40);
        }
        await wait(380);
        resultEl.textContent = queries[i].a;
        resultEl.classList.add('is-shown');
        await wait(3200);
      }
    };
    loop();
  } else terminal?.querySelector('[data-terminal-result]')?.classList.add('is-shown');

  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (button: HTMLButtonElement) => {
      buttons.forEach((b) => {
        const selected = b === button;
        b.setAttribute('aria-selected', String(selected));
        b.tabIndex = selected ? 0 : -1;
        document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !selected;
      });
      button.focus();
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(button));
      button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
          select(buttons[(index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length]);
        }
      });
    });
    const copy = tabs.querySelector<HTMLButtonElement>('[data-copy-curl]');
    copy?.addEventListener('click', async () => {
      const state = copy.querySelector('[data-copy-state]')!;
      try {
        await navigator.clipboard.writeText(`curl ${location.origin}${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/profile.json`);
        state.textContent = '✓ copied';
      } catch {
        state.textContent = '✗';
      }
      setTimeout(() => (state.textContent = '⧉'), 1800);
    });
  }
</script>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 6vw, 4.5rem); }
  .hero::after { position: absolute; top: -20%; right: -10%; width: 60vw; height: 60vw; border-radius: 50%; background: radial-gradient(circle, var(--glow), transparent 60%); content: ''; opacity: .35; filter: blur(40px); pointer-events: none; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); }
  .hero-title { margin-bottom: 1.4rem; font-size: clamp(2.6rem, 5.6vw, 4.8rem); font-weight: 700; letter-spacing: -.05em; line-height: 1.02; }
  .hero-intro { max-width: 560px; margin-bottom: 1.6rem; color: var(--text-soft); font-size: clamp(1.02rem, 1.4vw, 1.15rem); }
  .hero-intro strong { color: var(--text); }

  .terminal { max-width: 560px; margin-bottom: 1.8rem; overflow: hidden; font-family: var(--mono); font-size: .8rem; }
  .terminal-bar { display: flex; align-items: center; gap: .4rem; padding: .55rem .8rem; border-bottom: 1px solid var(--line); color: var(--text-mute); font-size: .68rem; }
  .terminal-bar i { width: .6rem; height: .6rem; border-radius: 50%; background: var(--line-strong); }
  .terminal-bar i:first-child { background: #ff5f57; } .terminal-bar i:nth-child(2) { background: #febc2e; } .terminal-bar i:nth-child(3) { background: #28c840; }
  .terminal-bar span { margin-left: .5rem; }
  .terminal-body { min-height: 4.6rem; padding: .8rem 1rem; }
  .terminal-body p { margin: 0; overflow-wrap: anywhere; }
  .prompt { color: var(--accent); }
  .caret { display: inline-block; width: .55em; height: 1em; margin-left: 2px; background: var(--accent-fill); vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  .terminal-result { margin-top: .35rem !important; color: var(--accent-2); opacity: 0; transition: opacity .3s ease; }
  .terminal-result:global(.is-shown) { opacity: 1; }

  .hero-actions { margin-bottom: 1.2rem; }
  .hero-contact { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0; color: var(--text-mute); font-size: .74rem; }
  .hero-contact a { color: var(--text-soft); text-decoration: none; }
  .hero-contact a:hover { color: var(--accent); }

  .hero-portrait { position: relative; width: 100%; max-width: 420px; justify-self: end; }
  .detect { position: relative; aspect-ratio: .8; overflow: hidden; border-radius: var(--radius); background: #111; box-shadow: var(--shadow); }
  .detect img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; filter: saturate(.9) contrast(1.05); }
  .detect::after { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(7 9 13 / 55%)), repeating-linear-gradient(0deg, rgb(255 255 255 / 3%) 0 1px, transparent 1px 3px); content: ''; pointer-events: none; }
  .scan { position: absolute; right: 0; left: 0; z-index: 2; height: 30%; background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent-fill) 22%, transparent), transparent); animation: scan 4.5s cubic-bezier(.5, 0, .5, 1) 1s 2 both; pointer-events: none; }
  @keyframes scan { from { top: -30%; } to { top: 100%; } }
  .bbox { position: absolute; top: 14%; right: 18%; bottom: 30%; left: 20%; z-index: 3; border: 1px solid color-mix(in srgb, var(--accent-fill) 70%, transparent); animation: bbox-in .6s ease-out 1.8s both; }
  @keyframes bbox-in { from { opacity: 0; transform: scale(1.15); } }
  .bbox-label { position: absolute; bottom: 100%; left: -1px; padding: .15rem .45rem; background: var(--accent-fill); color: var(--accent-ink); font-family: var(--mono); font-size: .64rem; font-weight: 600; white-space: nowrap; }
  .bbox .c { position: absolute; width: 14px; height: 14px; border: 2px solid var(--accent-fill); }
  .bbox .tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
  .bbox .tr { top: -2px; right: -2px; border-bottom: 0; border-left: 0; }
  .bbox .bl { bottom: -2px; left: -2px; border-top: 0; border-right: 0; }
  .bbox .br { right: -2px; bottom: -2px; border-top: 0; border-left: 0; }
  .float-tags { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .float-tags li { position: absolute; padding: .4rem .65rem; border: 1px solid var(--line-strong); border-radius: 8px; background: color-mix(in srgb, var(--bg-elev) 88%, transparent); backdrop-filter: blur(10px); box-shadow: var(--shadow); color: var(--text-mute); font-size: .68rem; white-space: nowrap; animation: float 6s ease-in-out var(--d) infinite; }
  .float-tags b { color: var(--code-string); font-weight: 500; }
  .float-tags li:nth-child(1) { top: -3%; left: -18%; }
  .float-tags li:nth-child(2) { top: 56%; right: -14%; }
  .float-tags li:nth-child(3) { bottom: 6%; left: -10%; }
  @keyframes float { 50% { transform: translateY(-8px); } }

  .json-panel { overflow: hidden; }
  .tabs { display: flex; align-items: center; gap: .25rem; padding: .5rem .5rem 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 40%, transparent); }
  .tabs [role='tab'] { padding: .6rem 1rem; border: 1px solid transparent; border-bottom: 0; border-radius: 8px 8px 0 0; background: transparent; color: var(--text-mute); cursor: pointer; font: 500 .8rem var(--mono); }
  .tabs [role='tab'][aria-selected='true'] { border-color: var(--line); background: var(--surface); color: var(--text); box-shadow: inset 0 2px 0 var(--accent); }
  .tabs-spacer { flex: 1; }
  .copy-button { margin-bottom: .35rem; padding: .4rem .7rem; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: var(--text-mute); cursor: pointer; font-size: .7rem; }
  .copy-button:hover { border-color: var(--accent); color: var(--text); }
  .tab-panel { padding: clamp(1.25rem, 3vw, 2rem); }
  .human-view p { max-width: 760px; color: var(--text-soft); }
  .md-h1 { margin-bottom: .4rem; color: var(--text) !important; font-size: 1.6rem; font-weight: 700; letter-spacing: -.03em; }
  .md-h2 { margin: 1.4rem 0 .4rem; color: var(--text) !important; font-size: 1.1rem; font-weight: 650; }
  .md-mark { color: var(--accent); font-family: var(--mono); font-weight: 400; }
  .md-quote { padding-left: .9rem; border-left: 2px solid var(--accent); font-style: italic; }
  .chip-row { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .code { margin: 0; overflow-x: auto; font-size: .8rem; line-height: 1.7; }
  .code :global(.tok-key) { color: var(--code-key); }
  .code :global(.tok-string) { color: var(--code-string); }
  .code :global(.tok-number) { color: var(--code-number); }
  .code :global(.tok-literal) { color: var(--code-literal); }
  .code :global(.tok-punct) { color: var(--code-punct); }
  .code :global(.tok-comment) { color: var(--text-mute); font-style: italic; }

  .explore-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .explore-card { display: flex; min-height: 210px; flex-direction: column; gap: .5rem; padding: 1.4rem; color: inherit; text-decoration: none; }
  .explore-path { color: var(--accent); font-size: .74rem; }
  .explore-title { margin-top: auto; font-size: 1.45rem; font-weight: 650; letter-spacing: -.03em; }
  .explore-note { color: var(--text-soft); font-size: .86rem; line-height: 1.5; }
  .explore-arrow { position: absolute; top: 1.2rem; right: 1.3rem; color: var(--text-mute); transition: color .2s ease, transform .2s ease; }
  .explore-card:hover .explore-arrow { color: var(--accent); transform: translate(3px, -3px); }

  @media (max-width: 1080px) { .explore-grid { grid-template-columns: repeat(2, 1fr); } .float-tags li:nth-child(1) { left: -6%; } .float-tags li:nth-child(2) { right: -4%; } }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-portrait { max-width: 340px; justify-self: center; margin-top: 1rem; }
    .float-tags li:nth-child(1) { left: -10%; } .float-tags li:nth-child(2) { right: -12%; }
  }
  @media (max-width: 560px) {
    .explore-grid { grid-template-columns: 1fr; }
    .explore-card { min-height: 150px; }
    .float-tags li:nth-child(2) { display: none; }
    .copy-button { display: none; }
  }
</style>
