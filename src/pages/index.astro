---
import SiteLayout from '../layouts/SiteLayout.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SiteLayout title="Higor Lima | Business Analyst" description="The professional CV and experience of Higor Lima, Senior Business Analyst based in Warsaw, Poland.">
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Personal CV · Warsaw, Poland</p>
      <h1>Making data<br /><em>work for people.</em></h1>
      <p class="hero-intro"><strong>{profile.name}</strong> is a {profile.title.toLowerCase()} with 5+ years of experience across data analysis, business intelligence, and media analytics.</p>
      <p class="hero-detail">{profile.focus}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}/experience/`}>Explore experience <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`${base}/skills/`}>View skills <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-index"><span>01 / 05</span><span>Business analysis · Data · Insights</span></div>
    </div>
    <div class="hero-portrait-wrap">
      <div class="portrait-frame">
        <img src={`${base}${profile.portrait}`} alt={profile.portraitAlt} width="900" height="1305" fetchpriority="high" />
      </div>
      <div class="portrait-caption"><span>Higor Lima</span><span>Business Analyst</span></div>
      <span class="portrait-mark" aria-hidden="true">HL</span>
    </div>
  </section>

  <section class="home-links page-shell" aria-labelledby="explore-heading">
    <div class="section-heading">
      <p class="eyebrow">A closer look</p>
      <h2 id="explore-heading">Explore the work.</h2>
    </div>
    <div class="link-grid">
      <a class="link-card" href={`${base}/story/`}><span class="card-number">01</span><span class="card-title">Story</span><span class="card-arrow" aria-hidden="true">↗</span><span class="card-note">A personal introduction</span></a>
      <a class="link-card" href={`${base}/experience/`}><span class="card-number">02</span><span class="card-title">Experience</span><span class="card-arrow" aria-hidden="true">↗</span><span class="card-note">Roles and career timeline</span></a>
      <a class="link-card" href={`${base}/skills/`}><span class="card-number">03</span><span class="card-title">Skills</span><span class="card-arrow" aria-hidden="true">↗</span><span class="card-note">Tools and areas of practice</span></a>
      <a class="link-card" href={`${base}/projects/`}><span class="card-number">04</span><span class="card-title">Projects</span><span class="card-arrow" aria-hidden="true">↗</span><span class="card-note">Selected work and ideas</span></a>
    </div>
  </section>
</SiteLayout>
