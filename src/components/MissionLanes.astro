---
import { missions, operatingModel } from '../data/contributions';

const start = new Date(2026, 2, 1);
const now = new Date();
const end = new Date(now.getFullYear(), now.getMonth() + 1, 1);
const span = end.getTime() - start.getTime();
const at = (ym: string | null) => {
  if (!ym) return 1;
  const [y, m] = ym.split('-').map(Number);
  return (new Date(y, m - 1, 1).getTime() - start.getTime()) / span;
};
const toEnd = (ym: string | null) => {
  if (!ym) return 1;
  const [y, m] = ym.split('-').map(Number);
  return (new Date(y, m, 1).getTime() - start.getTime()) / span;
};
const months: string[] = [];
for (let d = new Date(start); d < end; d.setMonth(d.getMonth() + 1)) months.push(d.toLocaleString('en', { month: 'short' }));
---

<figure class="lanes" aria-labelledby="lanes-caption">
  <figcaption id="lanes-caption">
    <span class="comment">// missions.swimlane — {operatingModel.name}</span>
    <span class="lanes-note">{operatingModel.text}</span>
  </figcaption>
  <div class="lanes-scroll">
    <div class="lanes-body">
      <div class="lanes-months" aria-hidden="true">{months.map((m) => <span>{m}</span>)}</div>
      <ol class="lanes-rows">
        {missions.map((mission) => (
          <li class="lane">
            <div class="lane-head"><strong>{mission.name}</strong><span>{mission.period}</span></div>
            <div class="lane-track">
              <span class:list={['lane-bar', { 'is-open': !mission.end }]} style={`left:${(at(mission.start) * 100).toFixed(2)}%;width:${((toEnd(mission.end) - at(mission.start)) * 100).toFixed(2)}%`}></span>
            </div>
            <div class="lane-detail">
              <ul class="lane-roles">{mission.roles.map((role) => <li class="chip">{role}</li>)}</ul>
              <p>{mission.delivered}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>

<style>
  .lanes { margin: 1.5rem 0 1rem; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--bg) 45%, transparent); }
  figcaption { display: grid; gap: .35rem; margin-bottom: 1rem; }
  .lanes-note { color: var(--text-soft); font-size: .84rem; }
  .lanes-scroll { overflow-x: auto; }
  .lanes-body { min-width: 560px; }
  .lanes-months { display: grid; grid-auto-columns: 1fr; grid-auto-flow: column; margin-bottom: .4rem; color: var(--text-mute); font-family: var(--mono); font-size: .65rem; }
  .lanes-months span { padding-left: .25rem; border-left: 1px dashed var(--line); }
  .lanes-rows { display: grid; gap: .9rem; margin: 0; padding: 0; list-style: none; }
  .lane-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; margin-bottom: .3rem; }
  .lane-head strong { font-size: .86rem; }
  .lane-head span { color: var(--text-mute); font-family: var(--mono); font-size: .66rem; }
  .lane-track { position: relative; height: .75rem; border-radius: 6px; background: var(--surface-2); }
  .lane-bar { position: absolute; top: 0; bottom: 0; border-radius: 6px; background: var(--accent-fill); box-shadow: 0 0 14px -3px var(--accent-fill); }
  .lane-bar.is-open { background: linear-gradient(90deg, var(--accent-fill) 80%, color-mix(in srgb, var(--accent-fill) 20%, transparent)); }
  .lane-detail { display: grid; gap: .35rem; margin-top: .45rem; }
  .lane-detail p { margin: 0; color: var(--text-soft); font-size: .84rem; }
  .lane-roles { display: flex; flex-wrap: wrap; gap: .3rem; margin: 0; padding: 0; list-style: none; }
  .lane-roles .chip { font-size: .66rem; }
</style>
