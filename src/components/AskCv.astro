---
import { knowledge } from '../data/knowledge';
import { base } from '../lib/paths';

const suggestions = [
  'What does Higor do at Bayer?',
  'Has he used GitHub Copilot?',
  'What decisions has he made?',
  'Experience with Databricks?',
  'Has he given talks?',
  'How can I contact him?',
];
---

<button class="askcv-fab" type="button" data-askcv-open aria-label="Ask my CV" aria-haspopup="dialog" aria-expanded="false" aria-controls="askcv-panel">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"></path><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"></path></svg>
  <span>Ask my CV</span>
</button>

<section class="askcv-panel" id="askcv-panel" role="dialog" aria-modal="false" aria-labelledby="askcv-title" data-askcv-panel hidden>
  <header class="askcv-head">
    <div>
      <p class="askcv-title" id="askcv-title"><span class="eyebrow-dot"></span> Ask my CV</p>
      <p class="askcv-sub">Retrieval runs 100% in your browser · no AI service · no data leaves this page</p>
    </div>
    <button class="icon-button" type="button" data-askcv-close aria-label="Close Ask my CV">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </header>
  <div class="askcv-log" data-askcv-log aria-live="polite">
    <div class="msg msg-bot"><p>Hi! I answer questions using only the content of Higor’s CV, and I link every answer to its source. What would you like to know?</p></div>
  </div>
  <div class="askcv-suggestions" data-askcv-suggestions>
    {suggestions.map((text) => <button type="button" class="chip" data-suggestion>{text}</button>)}
  </div>
  <form class="askcv-form" data-askcv-form>
    <label class="visually-hidden" for="askcv-input">Your question</label>
    <input id="askcv-input" name="q" autocomplete="off" placeholder="e.g. Has he worked with BigQuery?" maxlength="200" required />
    <button class="askcv-send" type="submit" aria-label="Send question">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </button>
  </form>
</section>

<script type="application/json" id="askcv-data" set:html={JSON.stringify({ base, knowledge })} />

<script>
  import { createAsker, type Answer } from '../lib/ask';

  const panel = document.querySelector<HTMLElement>('[data-askcv-panel]')!;
  const fab = document.querySelector<HTMLButtonElement>('[data-askcv-open]')!;
  const log = panel.querySelector<HTMLElement>('[data-askcv-log]')!;
  const form = panel.querySelector<HTMLFormElement>('[data-askcv-form]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const { base, knowledge } = JSON.parse(document.getElementById('askcv-data')!.textContent!);
  const ask = createAsker(knowledge);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const open = () => {
    panel.hidden = false;
    fab.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => panel.classList.add('is-open'));
    input.focus();
  };
  const close = () => {
    panel.classList.remove('is-open');
    fab.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
    fab.focus();
  };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  const typeInto = async (node: HTMLElement, text: string) => {
    if (reduceMotion) {
      node.textContent = text;
      return;
    }
    for (let i = 0; i <= text.length; i += 3) {
      node.textContent = text.slice(0, i);
      log.scrollTop = log.scrollHeight;
      await new Promise((resolve) => setTimeout(resolve, 8));
    }
    node.textContent = text;
  };

  const render = async (answer: Answer) => {
    const message = el('div', 'msg msg-bot');
    const thinking = el('p', 'thinking', 'retrieving');
    message.append(thinking);
    log.append(message);
    log.scrollTop = log.scrollHeight;
    await new Promise((resolve) => setTimeout(resolve, reduceMotion ? 0 : 420));
    thinking.remove();

    const intro = el('p');
    message.append(intro);
    await typeInto(intro, answer.intro);

    if (answer.items.length) {
      const list = el('ol', 'sources');
      for (const item of answer.items) {
        const li = el('li');
        const link = el('a', 'source-title', item.title) as HTMLAnchorElement;
        link.href = `${base}${item.href}`;
        li.append(link, el('span', 'source-text', item.text));
        list.append(li);
      }
      message.append(list);
    }
    if (answer.missing.length) message.append(el('p', 'missing', `Not mentioned in the CV: ${answer.missing.join(', ')}`));
    log.scrollTop = log.scrollHeight;
  };

  const submit = (question: string) => {
    const text = question.trim();
    if (!text) return;
    log.append(Object.assign(el('div', 'msg msg-user'), { textContent: text }));
    input.value = '';
    render(ask(text));
  };

  fab.addEventListener('click', () => (panel.hidden ? open() : close()));
  panel.querySelector('[data-askcv-close]')!.addEventListener('click', close);
  panel.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    submit(input.value);
  });
  panel.querySelectorAll<HTMLButtonElement>('[data-suggestion]').forEach((button) =>
    button.addEventListener('click', () => submit(button.textContent ?? '')),
  );
  window.addEventListener('askcv:open', ((event: CustomEvent<string | undefined>) => {
    open();
    if (event.detail) submit(event.detail);
  }) as EventListener);
</script>

<style is:global>
  .askcv-fab { position: fixed; right: clamp(1rem, 3vw, 1.75rem); bottom: clamp(1rem, 3vw, 1.75rem); z-index: 50; display: inline-flex; align-items: center; gap: .55rem; padding: .8rem 1.1rem; border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(12px); color: var(--text); cursor: pointer; font: 600 .88rem var(--sans); box-shadow: 0 10px 40px -10px var(--glow); transition: transform .2s ease, box-shadow .2s ease; }
  .askcv-fab:hover { transform: translateY(-2px); box-shadow: 0 16px 50px -10px var(--glow); }
  .askcv-fab svg { width: 18px; height: 18px; color: var(--accent); }
  .askcv-panel { position: fixed; right: clamp(1rem, 3vw, 1.75rem); bottom: calc(clamp(1rem, 3vw, 1.75rem) + 64px); z-index: 60; display: flex; width: min(420px, calc(100vw - 2rem)); height: min(600px, calc(100vh - 140px)); flex-direction: column; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 18px; background: color-mix(in srgb, var(--bg-elev) 94%, transparent); backdrop-filter: blur(18px); box-shadow: var(--shadow), 0 0 0 1px color-mix(in srgb, var(--accent) 12%, transparent); opacity: 0; transform: translateY(12px) scale(.98); transform-origin: bottom right; transition: opacity .2s ease, transform .2s ease; }
  .askcv-panel.is-open { opacity: 1; transform: none; }
  .askcv-panel[hidden] { display: none; }
  .askcv-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; padding: 1rem 1rem .85rem 1.1rem; border-bottom: 1px solid var(--line); }
  .askcv-title { display: flex; align-items: center; gap: .55rem; margin: 0; font-weight: 650; }
  .askcv-sub { margin: .2rem 0 0; color: var(--text-mute); font-family: var(--mono); font-size: .66rem; line-height: 1.5; }
  .askcv-log { flex: 1; display: flex; flex-direction: column; gap: .75rem; overflow-y: auto; padding: 1rem 1.1rem; scroll-behavior: smooth; }
  .msg { max-width: 92%; padding: .7rem .9rem; border-radius: 14px; font-size: .88rem; line-height: 1.55; }
  .msg p { margin: 0; }
  .msg-user { align-self: end; background: var(--accent-fill); color: var(--accent-ink); border-bottom-right-radius: 4px; font-weight: 500; }
  .msg-bot { align-self: start; border: 1px solid var(--line); background: var(--surface); border-bottom-left-radius: 4px; }
  .thinking { color: var(--text-mute); font-family: var(--mono); font-size: .75rem; }
  .thinking::after { content: '…'; animation: blink 1s steps(1) infinite; }
  .sources { display: grid; gap: .6rem; margin: .7rem 0 0; padding-left: 1.2rem; }
  .sources li::marker { color: var(--accent); font-family: var(--mono); font-size: .75rem; }
  .source-title { display: block; color: var(--accent); font-size: .78rem; font-weight: 600; text-decoration: none; }
  .source-title:hover { text-decoration: underline; }
  .source-text { color: var(--text-soft); font-size: .84rem; }
  .missing { margin-top: .6rem !important; color: var(--accent-4); font-family: var(--mono); font-size: .72rem; }
  .askcv-suggestions { display: flex; gap: .4rem; overflow-x: auto; padding: .25rem 1.1rem .75rem; scrollbar-width: none; }
  .askcv-suggestions .chip { flex: 0 0 auto; cursor: pointer; }
  .askcv-suggestions .chip:hover { border-color: var(--accent); color: var(--text); }
  .askcv-form { display: flex; gap: .5rem; padding: .75rem; border-top: 1px solid var(--line); }
  .askcv-form input { flex: 1; min-width: 0; padding: .7rem .9rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--surface); color: var(--text); font: .9rem var(--sans); }
  .askcv-form input:focus { outline: none; border-color: var(--accent); }
  .askcv-send { display: grid; width: 42px; height: 42px; place-items: center; border: 0; border-radius: 50%; background: var(--accent-fill); color: var(--accent-ink); cursor: pointer; }
  .askcv-send svg { width: 18px; height: 18px; }
  @media (max-width: 520px) { .askcv-fab span { display: none; } .askcv-fab { padding: .85rem; } }
  @media print { .askcv-fab, .askcv-panel { display: none !important; } }
</style>
