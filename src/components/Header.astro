---
import { navigation } from '../data/navigation';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  currentPath: string;
  base: string;
}

const { currentPath, base } = Astro.props;
const activePath = currentPath.replace(/index\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={`${base}/`} aria-label="Higor Lima home">HL<span>.</span></a>
    <MobileNavigation>
      <ul>
        {navigation.map((item, index) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = activePath === itemPath || (itemPath !== '/' && activePath.startsWith(`${itemPath}/`));
          return (
            <li>
              <a href={`${base}${item.href}`} aria-current={isActive ? 'page' : undefined}>
                <span class="nav-number">{String(index + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
                <span class="nav-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ul>
    </MobileNavigation>
  </div>
</header>
