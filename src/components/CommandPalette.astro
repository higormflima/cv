---
import { profile } from '../data/profile';
import { experience, shortRole } from '../data/experience';
import { base } from '../lib/paths';

const items = [
  { group: 'Navigate', label: 'Home', hint: '~/', action: 'go', value: '/' },
  { group: 'Navigate', label: 'Story', hint: '~/story', action: 'go', value: '/story/' },
  { group: 'Navigate', label: 'Experience', hint: '~/experience', action: 'go', value: '/experience/' },
  { group: 'Navigate', label: 'Skills graph', hint: '~/skills', action: 'go', value: '/skills/' },
  { group: 'Navigate', label: 'Projects', hint: '~/projects', action: 'go', value: '/projects/' },
  { group: 'Navigate', label: 'Decisions (ADRs & RFCs)', hint: '~/decisions', action: 'go', value: '/decisions/' },
  { group: 'Navigate', label: 'AI-ready data products', hint: 'case study', action: 'go', value: '/projects/ai-ready-data-products/' },
  { group: 'Navigate', label: 'Enterprise Data Integration', hint: 'project', action: 'go', value: '/projects/enterprise-data-integration/' },
  { group: 'Navigate', label: 'Odisseia Mundana', hint: 'project', action: 'go', value: '/projects/odisseia-mundana/' },
  ...experience.map((role) => ({ group: 'Roles', label: `${role.organization}`, hint: shortRole(role), action: 'go', value: `/experience/#${role.id}` })),
  { group: 'Actions', label: 'Ask my CV', hint: 'local Q&A', action: 'ask', value: '' },
  { group: 'Actions', label: 'Toggle light / dark theme', hint: 'theme', action: 'theme', value: '' },
  { group: 'Actions', label: 'Download CV (PDF)', hint: '.pdf', action: 'open', value: '/documents/higor-lima-cv.pdf' },
  { group: 'Actions', label: 'Download CV (Markdown)', hint: '.md', action: 'open', value: '/documents/higor-lima-cv.md' },
  { group: 'Actions', label: 'Open profile.json', hint: 'GET /api', action: 'open', value: '/api/profile.json' },
  { group: 'Actions', label: 'Copy email address', hint: profile.email, action: 'copy', value: profile.email },
  { group: 'Actions', label: 'Open LinkedIn', hint: '↗', action: 'external', value: profile.linkedIn },
];
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-inner">
    <div class="palette-search">
      <span class="palette-prompt" aria-hidden="true">❯</span>
      <input type="text" data-palette-input placeholder="Jump to… or type a command (try help)" autocomplete="off" spellcheck="false" aria-label="Search pages and actions, or type a terminal command" aria-controls="palette-list" />
      <kbd>esc</kbd>
    </div>
    <pre class="palette-terminal" data-palette-terminal aria-live="polite" hidden></pre>
    <ul class="palette-list" id="palette-list" role="listbox" data-palette-list>
      {items.map((item, index) => (
        <li role="option" aria-selected={index === 0 ? 'true' : 'false'} data-item data-group={item.group} data-action={item.action} data-value={item.value} data-label={item.label.toLowerCase()} data-hint={item.hint.toLowerCase()}>
          <span class="palette-group">{item.group}</span>
          <span class="palette-label">{item.label}</span>
          <span class="palette-hint">{item.hint}</span>
        </li>
      ))}
    </ul>
    <p class="palette-empty" data-palette-empty hidden>No matches. Press <kbd>Enter</kbd> to run it as a command, or type <code>help</code>.</p>
    <footer class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> navigate</span><span><kbd>↵</kbd> select</span><span>type <code>help</code> for the terminal</span></footer>
  </div>
</dialog>

<script type="application/json" id="palette-data" set:html={JSON.stringify({ base, email: profile.email, linkedIn: profile.linkedIn, roles: experience.map((r) => `${r.start} ${r.end ?? 'now    '}  ${r.organization} — ${shortRole(r)}`) })} />

<script>
  import { toggleTheme } from '../lib/theme';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const list = dialog.querySelector<HTMLElement>('[data-palette-list]')!;
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const terminal = dialog.querySelector<HTMLElement>('[data-palette-terminal]')!;
  const items = [...list.querySelectorAll<HTMLElement>('[data-item]')];
  const data = JSON.parse(document.getElementById('palette-data')!.textContent!);
  let active = 0;

  const visible = () => items.filter((item) => !item.hidden);

  const setActive = (index: number) => {
    const shown = visible();
    if (!shown.length) return;
    active = (index + shown.length) % shown.length;
    shown.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    shown[active].scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const query = input.value.trim().toLowerCase();
    const terms = query.split(/\s+/).filter(Boolean);
    items.forEach((item) => {
      const haystack = `${item.dataset.label} ${item.dataset.hint} ${item.dataset.group?.toLowerCase()}`;
      item.hidden = !terms.every((term) => haystack.includes(term));
    });
    empty.hidden = visible().length > 0;
    setActive(0);
  };

  const openPalette = () => {
    if (dialog.open) return;
    input.value = '';
    terminal.hidden = true;
    terminal.textContent = '';
    filter();
    dialog.showModal();
    input.focus();
  };

  const run = (item: HTMLElement) => {
    const { action, value = '' } = item.dataset;
    dialog.close();
    if (action === 'go' || action === 'open') window.location.href = `${data.base}${value}`;
    if (action === 'external') window.open(value, '_blank', 'noopener');
    if (action === 'theme') toggleTheme();
    if (action === 'ask') window.dispatchEvent(new CustomEvent('askcv:open'));
    if (action === 'copy') navigator.clipboard?.writeText(value);
  };

  const print = (text: string) => {
    terminal.hidden = false;
    terminal.textContent += `${text}\n`;
    terminal.scrollTop = terminal.scrollHeight;
  };

  const commands: Record<string, (args: string[]) => void> = {
    help: () =>
      print(['available commands:', '  whoami            who is this?', '  ls [projects]     list sections or projects', '  cat cv.json       print the machine-readable CV', '  history           career log', '  ask <question>    ask my CV', '  theme             toggle light/dark', '  contact           how to reach me', '  sudo hire higor   try it', '  clear | exit'].join('\n')),
    whoami: () => print('higor lima — data specialist @ bayer · warsaw, pl\nbuilding AI-ready data foundations: from raw data to real business value.'),
    ls: (args) =>
      print(args[0]?.startsWith('proj') ? 'ai-ready-data-products/   enterprise-data-integration/   odisseia-mundana/' : 'story/   experience/   skills/   projects/   decisions/   api/profile.json   documents/higor-lima-cv.pdf'),
    cat: (args) => {
      if (/cv|profile|json/.test(args[0] ?? '')) {
        print('fetching /api/profile.json …');
        fetch(`${data.base}/api/profile.json`)
          .then((response) => response.json())
          .then((json) => print(JSON.stringify(json.basics, null, 2) + `\n… ${json.work.length} roles, ${json.skills.length} skill groups. open with: open cv.json`))
          .catch(() => print('error: could not fetch profile.json'));
      } else print(`cat: ${args[0] ?? ''}: no such file. try: cat cv.json`);
    },
    open: (args) => {
      if (/cv|profile|json/.test(args[0] ?? '')) window.location.href = `${data.base}/api/profile.json`;
      else print('usage: open cv.json');
    },
    history: () => print(data.roles.slice().reverse().join('\n')),
    ask: (args) => {
      dialog.close();
      window.dispatchEvent(new CustomEvent('askcv:open', { detail: args.join(' ') || undefined }));
    },
    theme: () => {
      toggleTheme();
      print(`theme → ${document.documentElement.dataset.theme}`);
    },
    contact: () => print(`email:    ${data.email}\nlinkedin: ${data.linkedIn}`),
    sudo: (args) =>
      print(args.join(' ') === 'hire higor' ? '[sudo] permission granted ✓\n→ opening an email draft…' : 'sudo: only "sudo hire higor" is permitted here'),
    date: () => print(new Date().toString()),
    clear: () => {
      terminal.textContent = '';
      terminal.hidden = true;
    },
    exit: () => dialog.close(),
  };

  const runCommand = (raw: string) => {
    const [name, ...args] = raw.trim().split(/\s+/);
    const command = commands[name.toLowerCase()];
    if (name !== 'clear') print(`$ ${raw.trim()}`);
    if (command) command(args);
    else print(`command not found: ${name}. type help`);
    if (raw.trim() === 'sudo hire higor') setTimeout(() => (window.location.href = `mailto:${data.email}?subject=Let%27s%20talk`), 900);
    input.value = '';
    filter();
  };

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const value = input.value.trim();
      const first = value.split(/\s+/)[0]?.toLowerCase();
      if (first && commands[first]) runCommand(value);
      else if (visible()[active]) run(visible()[active]);
      else if (value) runCommand(value);
    }
  });
  list.addEventListener('click', (event) => {
    const item = (event.target as HTMLElement).closest<HTMLElement>('[data-item]');
    if (item) run(item);
  });
  list.addEventListener('mousemove', (event) => {
    const item = (event.target as HTMLElement).closest<HTMLElement>('[data-item]');
    if (item) setActive(visible().indexOf(item));
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      dialog.close();
    }
  });

  document.querySelectorAll('[data-palette-open]').forEach((button) => button.addEventListener('click', openPalette));
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.matches('input, textarea, [contenteditable="true"]');
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog.open ? dialog.close() : openPalette();
    } else if (!typing && (event.key === '/' || event.key === '`')) {
      event.preventDefault();
      openPalette();
    }
  });
</script>

<style is:global>
  .palette { width: min(640px, calc(100vw - 2rem)); max-height: min(560px, calc(100vh - 6rem)); margin: 12vh auto auto; padding: 0; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 16px; background: var(--bg-elev); color: var(--text); box-shadow: var(--shadow), 0 0 0 1px color-mix(in srgb, var(--accent) 15%, transparent), 0 30px 120px -30px var(--glow); }
  .palette::backdrop { background: rgb(2 4 8 / 55%); backdrop-filter: blur(4px); }
  .palette[open] { animation: palette-in .18s ease-out; }
  @keyframes palette-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } }
  .palette-inner { display: flex; max-height: inherit; flex-direction: column; }
  .palette-search { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--line); }
  .palette-prompt { color: var(--accent); font-family: var(--mono); }
  .palette-search input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--text); font: 1rem var(--mono); outline: none; }
  .palette-search input:focus-visible { outline: none; }
  .palette-terminal { max-height: 220px; margin: 0; overflow: auto; padding: .9rem 1.1rem; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 70%, transparent); color: var(--accent); font-size: .78rem; line-height: 1.6; white-space: pre-wrap; }
  .palette-list { flex: 1; margin: 0; overflow-y: auto; padding: .4rem; list-style: none; }
  .palette-list li { display: grid; grid-template-columns: 5.5rem 1fr auto; align-items: center; gap: .75rem; padding: .6rem .75rem; border-radius: 10px; cursor: pointer; }
  .palette-list li[hidden] { display: none; }
  .palette-list li[aria-selected='true'] { background: var(--surface-2); box-shadow: inset 2px 0 0 var(--accent); }
  .palette-group { color: var(--text-mute); font-family: var(--mono); font-size: .68rem; }
  .palette-label { font-size: .92rem; }
  .palette-hint { overflow: hidden; max-width: 16rem; color: var(--text-mute); font-family: var(--mono); font-size: .72rem; text-overflow: ellipsis; white-space: nowrap; }
  .palette-empty { margin: 0; padding: 1rem 1.1rem; color: var(--text-soft); font-size: .88rem; }
  .palette-foot { display: flex; flex-wrap: wrap; gap: 1rem; padding: .6rem 1.1rem; border-top: 1px solid var(--line); color: var(--text-mute); font-size: .72rem; }
  .palette-foot kbd { margin-right: .2rem; }
  @media (max-width: 520px) { .palette-list li { grid-template-columns: 1fr auto; } .palette-group { display: none; } }
</style>
